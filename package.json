{
    "name": "leck-eier-bot",
    "version": "1.0.0",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc && node scripts/copy-migrations.mjs && npm --prefix web ci && npm --prefix web run build",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "dev:web": "npm --prefix web run dev",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/bot/**/*.test.ts tests/db/**/*.test.ts tests/seam/**/*.test.ts",
        "env:example": "tsx scripts/generateEnvExample.ts",
        "dev:up": "node scripts/dev-up.mjs",
        "dev:down": "node scripts/dev-down.mjs",
        "db:generate": "drizzle-kit generate",
        "db:pull": "drizzle-kit pull"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/formbody": "^9.0.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/static": "^10.1.3",
        "better-sqlite3": "^13.0.3",
        "discord.js": "^14.25.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.3",
        "fastify": "^5.12.1",
        "fastify-type-provider-zod": "^7.0.0",
        "node-cron": "^4.2.1",
        "transliteration": "^2.6.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.2.0",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
